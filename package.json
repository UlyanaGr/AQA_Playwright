{
    "name": "git_playwright",
    "version": "1.0.0",
    "type": "module",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "npx playwright test",
        "test:ui:regression": "npx playwright test --project=sales-portal-ui --grep @regression|@smoke",
        "test:ui:smoke": "npm run test -- --project=sales-portal-ui --grep @smoke",
        "ui-mode": "npx playwright test --ui",
        "html:report:open": "npx playwright show-report",
        "allure:clear": "if exist allure-results rmdir /s /q allure-results && if exist allure-report rmdir /s /q allure-report",
        "allure:generate": "npx allure generate allure-results --clean -o allure-report",
        "allure:open": "npx allure open allure-report",
        "allure:report": "npm run allure:generate && npm run allure:open",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prettier": "prettier --config .prettierrc src/**/*.ts --check src/",
        "prettier:fix": "prettier --config .prettierrc src/**/*.ts --write src/",
        "format": " npm run prettier && npm run lint",
        "format:fix": "npm run prettier:fix && npm run lint:fix",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/UlyanaGr/AQA_Playwright.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/UlyanaGr/AQA_Playwright/issues"
    },
    "homepage": "https://github.com/UlyanaGr/AQA_Playwright#readme",
    "devDependencies": {
        "@playwright/test": "^1.56.1",
        "@types/ajv": "^0.0.5",
        "@types/bson": "^4.0.5",
        "@types/dotenv": "^6.1.1",
        "@types/lodash": "^4.17.20",
        "@types/moment": "^2.11.29",
        "@types/node": "^24.7.2",
        "allure-playwright": "^3.4.3"
    },
    "dependencies": {
        "@faker-js/faker": "^10.1.0",
        "ajv": "^8.17.1",
        "allure-commandline": "^2.36.0",
        "bson": "^7.0.0",
        "dotenv": "^17.2.3",
        "lodash": "^4.17.21",
        "moment": "^2.30.1"
    },
    "overrides": {
        "faker": "npm:@faker-js/faker@10.1.0"
    }
}
